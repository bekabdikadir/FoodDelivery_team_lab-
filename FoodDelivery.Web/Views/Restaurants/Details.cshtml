@model RestaurantDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<a asp-controller="Home" asp-action="Index" class="btn btn-link px-0 mb-3">&larr; Все заведения</a>

<div class="card shadow-sm mb-4">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Name" class="card-img-top details-img" />
    }
    <div class="card-body">
        <h1 class="h3 card-title">@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="card-text text-muted mb-0">@Model.Description</p>
        }
    </div>
</div>

<h2 class="h4 mb-3">Меню</h2>

@if (!Model.Dishes.Any())
{
    <div class="alert alert-info">В этом заведении пока нет блюд</div>
}
else
{
    <div class="row g-3">
        @foreach (var dish in Model.Dishes)
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex justify-content-between gap-3">
                        <div>
                            <h5 class="card-title mb-1">@dish.Name</h5>
                            <p class="card-text text-muted small mb-0">@dish.Description</p>
                        </div>
                        <div class="fw-bold text-nowrap">@dish.Price.ToString("0.00")</div>
                        <button type="button" class="btn btn-sm btn-primary align-self-end"
                                data-cart-add data-restaurant-id="@Model.Id" data-dish-id="@dish.Id">
                            Добавить в корзину
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
