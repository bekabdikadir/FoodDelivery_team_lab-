@model CheckoutViewModel
@{
    ViewData["Title"] = "Оформление заказа";
}

<a asp-controller="Restaurants" asp-action="Details" asp-route-id="@Model.RestaurantId" class="btn btn-link px-0">&larr; Вернуться в меню</a>
<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <h1 class="h3 mb-4">Оформление заказа</h1>
        <form asp-action="Checkout" method="post" class="card shadow-sm">
            <div class="card-body">
                <input asp-for="RestaurantId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="RecipientName" class="form-label"></label>
                    <input asp-for="RecipientName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="RecipientName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="RecipientEmail" class="form-label"></label>
                    <input asp-for="RecipientEmail" class="form-control" autocomplete="email" />
                    <span asp-validation-for="RecipientEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="RecipientPhone" class="form-label"></label>
                    <input asp-for="RecipientPhone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="RecipientPhone" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <textarea asp-for="DeliveryAddress" class="form-control" rows="3" autocomplete="street-address"></textarea>
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Подтвердить заказ</button>
            </div>
        </form>
    </div>
    <aside class="col-lg-5">
        <div class="card shadow-sm sticky-top cart-sticky">
            <div class="card-body">
                <h2 class="h5">@Model.Cart!.RestaurantName</h2>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="d-flex justify-content-between gap-3 py-2 border-top">
                        <span>@item.Name <span class="text-secondary">× @item.Quantity</span></span>
                        <span class="text-nowrap">@item.LineTotal.ToString("0.00") сом</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold border-top pt-3">
                    <span>Итого</span><span>@Model.Cart.Total.ToString("0.00") сом</span>
                </div>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
