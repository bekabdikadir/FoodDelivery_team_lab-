@model List<RestaurantDto>
@{
    ViewData["Title"] = "Заведения";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Заведения</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить заведение</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Заведений пока нет. Добавьте первое.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle bg-white shadow-sm">
            <thead>
                <tr>
                    <th style="width: 120px;">Изображение</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Блюд</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var restaurant in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(restaurant.ImageUrl))
                            {
                                <img src="@restaurant.ImageUrl" alt="@restaurant.Name" class="rounded" style="width: 100px; height: 70px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary-subtle rounded" style="width: 100px; height: 70px;"></div>
                            }
                        </td>
                        <td class="fw-semibold">@restaurant.Name</td>
                        <td class="text-muted small">@restaurant.Description</td>
                        <td>@restaurant.DishCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Dishes" asp-action="Index" asp-route-restaurantId="@restaurant.Id" class="btn btn-sm btn-outline-primary">Блюда</a>
                            <form asp-action="Delete" asp-route-id="@restaurant.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить заведение «@restaurant.Name» вместе со всеми блюдами?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}