@model List<UserDto>
@{
    ViewData["Title"] = "Пользователи";
    var currentUserId = ViewData["CurrentUserId"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Пользователи</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить пользователя</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white shadow-sm">
        <thead>
        <tr>
            <th>Email</th>
            <th>Имя</th>
            <th>Роли</th>
            <th class="text-end">Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FullName</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge bg-secondary">@role</span>
                    }
                </td>
                <td class="text-end">
                    @if (user.Id != currentUserId)
                    {
                        <a asp-action="Roles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Роли</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить пользователя @user.Email?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Это вы</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
