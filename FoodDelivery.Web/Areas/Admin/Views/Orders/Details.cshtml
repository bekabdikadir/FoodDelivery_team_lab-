@model OrderDetailsDto
@{
    ViewData["Title"] = $"Заказ №{Model.Id}";
}

<a asp-action="Index" class="btn btn-link px-0 mb-3">&larr; Все заказы</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Заказ №@Model.Id</h1>
        <p class="text-secondary mb-0">@Model.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.RestaurantName</p>
    </div>
    <span class="badge text-bg-primary fs-6">@Model.Total.ToString("0.00") сом</span>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <section class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Пользователь</h2>
                @if (Model.UserId is null)
                {
                    <p class="text-secondary">Заказ оформлен без регистрации.</p>
                }
                else
                {
                    <dl class="row mb-4">
                        <dt class="col-sm-4">ID</dt><dd class="col-sm-8 text-break">@Model.UserId</dd>
                        <dt class="col-sm-4">Email аккаунта</dt><dd class="col-sm-8">@(Model.AccountEmail ?? "Не указан")</dd>
                    </dl>
                }
                <h2 class="h5 mt-4">Получатель</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Имя</dt><dd class="col-sm-8">@Model.RecipientName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.RecipientEmail</dd>
                    <dt class="col-sm-4">Телефон</dt><dd class="col-sm-8">@Model.RecipientPhone</dd>
                    <dt class="col-sm-4">Адрес</dt><dd class="col-sm-8">@Model.DeliveryAddress</dd>
                </dl>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Состав заказа</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Блюдо</th><th class="text-end">Цена</th><th class="text-end">Порции</th><th class="text-end">Сумма</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr><td>@item.DishName</td><td class="text-end text-nowrap">@item.UnitPrice.ToString("0.00") сом</td><td class="text-end">@item.Quantity</td><td class="text-end text-nowrap">@item.LineTotal.ToString("0.00") сом</td></tr>
                            }
                        </tbody>
                        <tfoot><tr class="fw-bold"><td colspan="3">Итого</td><td class="text-end text-nowrap">@Model.Total.ToString("0.00") сом</td></tr></tfoot>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>
