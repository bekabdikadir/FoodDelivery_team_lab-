@model IReadOnlyList<OrderListItemDto>
@{
    ViewData["Title"] = "Заказы";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-link px-0">&larr; Администрирование</a>
        <h1 class="h3 mb-0">Все заказы</h1>
    </div>
    <span class="badge text-bg-secondary">@Model.Count заказов</span>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Заказов пока нет.</div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>№</th><th>Дата</th><th>Заведение</th><th>Получатель</th><th>Email</th><th class="text-end">Сумма</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td class="text-nowrap">@order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.RestaurantName</td>
                        <td>@order.RecipientName</td>
                        <td>@order.RecipientEmail</td>
                        <td class="text-end text-nowrap">@order.Total.ToString("0.00") сом</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Подробнее</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
